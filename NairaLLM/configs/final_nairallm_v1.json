{
  "model_name": "NairaLLM-30M",
  "version": "1.0.0-final",
  "canonical": true,
  "architecture": {
    "type": "CausalDecoderOnlyTransformer",
    "d_model": 512,
    "num_layers": 8,
    "num_heads": 8,
    "num_kv_heads": 8,
    "d_head": 64,
    "d_ff": 1536,
    "max_seq_len": 2048,
    "norm_type": "RMSNorm",
    "norm_eps": 1e-5,
    "activation": "SwiGLU",
    "position_embeddings": "RoPE",
    "rope_theta": 10000.0,
    "tie_embeddings": true,
    "dropout": 0.0,
    "parameter_count_tied": 29368832,
    "parameter_count_untied": 31465984
  },
  "tokenizer": {
    "type": "ByteLevelBPE",
    "tokenizer_path": "NairaLLM/model/tokenizer/naira_tokenizer.json",
    "vocab_size": 4096,
    "special_tokens": [
      "<|pad|>",
      "<|endoftext|>",
      "<|system|>",
      "<|user|>",
      "<|assistant|>",
      "<|context|>",
      "<|intent|>",
      "<|plan|>",
      "<|tool_call|>",
      "<|tool_result|>",
      "<|verify|>",
      "<|recover|>",
      "<|no_tool|>",
      "<|proactive|>",
      "<|final|>",
      "<|thought|>",
      "<|unk|>"
    ]
  },
  "training": {
    "precision": "fp16_amp",
    "optimizer": {
      "name": "AdamW",
      "learning_rate": 3e-4,
      "min_learning_rate": 1e-5,
      "betas": [0.9, 0.95],
      "weight_decay": 0.01,
      "grad_clip": 1.0
    },
    "scheduler": {
      "name": "CosineAnnealingLR",
      "warmup_steps": 100,
      "min_lr_ratio": 0.033
    },
    "batching": {
      "micro_batch_size": 8,
      "gradient_accumulation_steps": 4,
      "effective_batch_size": 32,
      "max_seq_len": 2048
    },
    "checkpoint_policy": {
      "save_every_epochs": 1,
      "eval_every_epochs": 1,
      "keep_best_metric": "val_loss",
      "enforce_parent_lineage": true,
      "checkpoint_dir": "NairaLLM/training/checkpoints",
      "cloud_backup_dir": "/content/drive/MyDrive/nairallm_checkpoints"
    }
  },
  "stages": [
    {
      "stage": "semantic",
      "order": 1,
      "description": "Foundation language modeling and semantic representations over balanced text corpus",
      "dataset_path": "NairaLLM/dataset/final/A_semantic/dataset_a_semantic.jsonl",
      "learning_rate": 3e-4,
      "epochs": 15
    },
    {
      "stage": "domain",
      "order": 2,
      "description": "Naira OS domain terminology, conversational tone, Hindi/Hinglish alignment, and basic intent understanding",
      "dataset_path": "NairaLLM/dataset/final/B_naira_capability/dataset_b_domain.jsonl",
      "learning_rate": 2e-4,
      "epochs": 12
    },
    {
      "stage": "cognition",
      "order": 3,
      "description": "Structured reasoning, planning, multi-step decomposition, and context resolution",
      "dataset_path": "NairaLLM/dataset/final/B_naira_capability/dataset_b_cognition.jsonl",
      "learning_rate": 1.5e-4,
      "epochs": 12
    },
    {
      "stage": "tools",
      "order": 4,
      "description": "Naira OS tool selection, argument generation, tool result interpretation, error recovery, and verification",
      "dataset_path": "NairaLLM/dataset/final/B_naira_capability/dataset_b_tools.jsonl",
      "learning_rate": 1e-4,
      "epochs": 15
    },
    {
      "stage": "behavior",
      "order": 5,
      "description": "Proactive behaviors, bounded autonomy levels 0-5, inactivity awareness, quiet mode, and safety escalation",
      "dataset_path": "NairaLLM/dataset/final/C_behavior/dataset_c_behavior.jsonl",
      "learning_rate": 8e-5,
      "epochs": 10
    }
  ],
  "hardware_constraints": {
    "target_platform": "free_cloud_gpu",
    "accelerator": "Tesla T4 / V100 / A100 (Free Tier)",
    "cuda_required_for_training": true,
    "allow_cpu_training": false,
    "free_compute_only": true,
    "max_cost_usd": 0.0
  }
}
