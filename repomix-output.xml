    PLUGIN_AUTHOR = "Tester"

    async def on_load(self) -> bool:
        return True

    async def on_unload(self) -> None:
        pass

    def get_tools(self) -> list[dict]:
        return [
            {
                "name": "dummy_tool",
                "description": "Dummy tool description",
