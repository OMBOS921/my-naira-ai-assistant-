    @abstractmethod
    async def list_upcoming_events(
        self, max_results: int = 10, calendar_id: str = "primary"
    ) -> list[CalendarEventInfo]:
        """List upcoming calendar events from now onwards."""

    @abstractmethod
    async def get_events_for_date(
