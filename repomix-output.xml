    ) -> list[CalendarEventInfo]:
        """List calendar events for a specific date (YYYY-MM-DD)."""

    @abstractmethod
    async def create_event(
        self,
        title: str,
        start_time_iso: str,
        end_time_iso: str,
        description: str = "",
        location: str = "",
