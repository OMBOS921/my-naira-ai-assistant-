        (tmp_project_dir / "yarn.lock").touch()
        detector = CapabilityDetector()
        caps = await detector.detect(str(tmp_project_dir))
        assert caps["package_manager"] == "yarn"

    async def test_detect_nonexistent_path(self) -> None:
