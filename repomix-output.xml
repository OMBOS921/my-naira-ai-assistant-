        await mgr.async_init()
        await mgr.async_shutdown()
        assert mgr.get_template_source() is None

    @pytest.mark.asyncio
    async def test_double_shutdown_is_safe(self) -> None:
        mgr = PromptManager()
        await mgr.async_init()
        await mgr.async_shutdown()
        await mgr.async_shutdown()
        assert mgr.get_template_source() is None

