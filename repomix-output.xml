                DefaultToolSelectionProvider,
            )
            self._tool_selector = DefaultToolSelectionProvider(logger=self._logger)

        if self._file_manager is None:
            allowed = []
            ws = getattr(self._config, "coding_agent", None)
            if ws:
                ws_dir = getattr(ws, "workspace_dir", "")
