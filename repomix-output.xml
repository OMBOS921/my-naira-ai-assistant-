                                "timeout": {"type": "number", "description": "Timeout in seconds"},
                            },
                            "required": ["selector"],
                        },
                        category="browser",
                        timeout_seconds=self._default_timeout,
                    ),
                    self._handle_click_tool,
                )

                register(
