    total_tokens: int


@dataclass(frozen=True)
class ToolCall:
    """A tool invocation requested by the LLM."""

    id: str
    name: str
    arguments: dict[str, Any]


@dataclass(frozen=True)
class ToolDef:
    """Definition of an available tool for the LLM."""

    name: str
    description: str
    parameters: JSON


