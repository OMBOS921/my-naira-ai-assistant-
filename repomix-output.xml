    assert plugin.PLUGIN_NAME == "dummy_plugin"
    assert plugin.is_enabled is True

    plugin.disable()
    assert plugin.is_enabled is False

    plugin.enable()
    assert plugin.is_enabled is True

    assert await plugin.on_load() is True
    await plugin.on_unload()


@pytest.mark.asyncio
