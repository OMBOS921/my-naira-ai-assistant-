        if self._command_executor is None:
            allowed_cmds = ()
            if ws:
                allowed_cmds = getattr(ws, "allowed_commands", ())
            from backend.modules.coding_agent.providers.command_executor_provider import (
                AsyncCommandExecutorProvider,
