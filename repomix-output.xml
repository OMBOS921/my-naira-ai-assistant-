# =========================================================================
# Helper
# =========================================================================


def _make_chunk(
    file_path: str = "test.py",
    content: str = "def foo(): pass",
    start: int = 1,
    end: int = 2,
) -> CodeChunk:
    return CodeChunk(
        chunk_id=f"chunk_{file_path}_{start}",
        file_path=file_path,
        start_line=start,
        end_line=end,
        content=content,
        strategy="function",
        language="Python",
        symbol_name="foo",
        token_count=max(1, len(content) // 4),
    )


