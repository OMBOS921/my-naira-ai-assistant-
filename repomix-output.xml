/* --- Naira OS Day 1 UI/UX Design System --- */

:root {
    --bg-base: #06050b;
    --bg-glass: rgba(12, 10, 24, 0.65);
    --bg-glass-heavy: rgba(18, 14, 36, 0.85);
    --border-glass: rgba(255, 255, 255, 0.07);
    --border-glass-cyan: rgba(0, 243, 255, 0.2);
    --border-glass-purple: rgba(157, 78, 223, 0.2);
    
    --neon-cyan: #00f3ff;
    --neon-purple: #bd5dff;
    --neon-magenta: #ff007f;
    --neon-green: #39ff14;
    --neon-red: #ff3131;
    
    --glow-cyan: 0 0 15px rgba(0, 243, 255, 0.45);
    --glow-purple: 0 0 15px rgba(189, 93, 255, 0.45);
    --glow-green: 0 0 15px rgba(57, 255, 20, 0.45);
    --glow-red: 0 0 15px rgba(255, 49, 49, 0.45);
    
    --text-primary: #f3f3f6;
    --text-muted: #8e8ca2;
    --text-dim: #545167;
    
    --font-cyber: 'Orbitron', 'Inter', sans-serif;
    --font-sans: 'Inter', sans-serif;
    --font-tech: 'Rajdhani', sans-serif;
}

/* --- Base Resets & Global Rules --- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-sans);
    user-select: none;
    -webkit-user-drag: none;
}

body, html {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: transparent;
}

/* Hide all scrollbars globally */
::-webkit-scrollbar {
    display: none;
}

/* --- App Container Frame --- */
.app-container {
    width: 100vw;
    height: 100vh;
    background: var(--bg-base);
    background-image: 
        radial-gradient(circle at 10% 20%, rgba(189, 93, 255, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(0, 243, 255, 0.08) 0%, transparent 40%);
    border: none;
    border-radius: 0;
    overflow: hidden;
    position: relative;
    box-shadow: none;
    display: flex;
    flex-direction: column;
}

/* --- Window Titlebar (Drag Handle & Controls) --- */
.titlebar {
    width: 100%;
    height: 40px;
    background: rgba(8, 6, 18, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-glass);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 16px;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 9999;
}

.pywebview-drag-container {
    /* Recognized by pywebview to make frameless window draggable */
    cursor: grab;
}

.titlebar-logo {
    display: flex;
    align-items: center;
    gap: 8px;
}

.titlebar-logo i {
    font-size: 14px;
    text-shadow: var(--glow-cyan);
}

.titlebar-title {
    font-family: var(--font-cyber);
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--text-primary);
    font-weight: 700;
}

.window-controls {
    display: flex;
    align-items: center;
    gap: 4px;
}

.no-drag {
    cursor: default;
}

.control-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.control-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
}

#btn-close:hover {
    background: var(--neon-red);
    color: white;
    box-shadow: var(--glow-red);
}

/* --- SPA Screen Framework --- */
.screen {
    width: 100%;
    height: 100%;
    padding-top: 40px;
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.97);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.screen.active {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
    z-index: 20;
}

/* --- Futuristic Glassmorphic Cards --- */
.glass-card {
    background: var(--bg-glass);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border-glass);
    border-radius: 12px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    padding: 30px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
}

.glass-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, transparent 60%);
    pointer-events: none;
}

/* --- Neon Glow Elements & Utility Classes --- */
.neon-text-cyan {
    color: var(--neon-cyan);
    text-shadow: var(--glow-cyan);
}

.neon-text-purple {
    color: var(--neon-purple);
    text-shadow: var(--glow-purple);
}

.hidden {
    display: none !important;
}

/* --- Form Fields & Inputs --- */
.form-group {
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-group label {
    font-family: var(--font-tech);
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--text-muted);
    text-transform: uppercase;
}

.input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.input-icon {
    position: absolute;
    left: 12px;
    color: var(--text-muted);
    font-size: 14px;
}

.input-wrapper input {
    width: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-glass);
    border-radius: 8px;
    padding: 12px 12px 12px 38px;
    color: var(--text-primary);
    font-size: 14px;
    outline: none;
    transition: all 0.3s ease;
}

.input-wrapper input:focus {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 10px rgba(0, 243, 255, 0.2), inset 0 0 4px rgba(0, 243, 255, 0.1);
    background: rgba(0, 243, 255, 0.02);
}

/* --- Sci-Fi Button Styles --- */
.glow-button {
    position: relative;
    padding: 12px 24px;
    background: transparent;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-family: var(--font-tech);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    overflow: hidden;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.glow-button.primary {
    border: 1px solid var(--neon-purple);
    color: var(--text-primary);
}

.glow-button.primary .btn-glow {
    background: radial-gradient(circle, var(--neon-purple) 0%, transparent 70%);
}

.glow-button.primary:hover {
    background: var(--neon-purple);
    color: #000;
    box-shadow: var(--glow-purple);
}

.glow-button.secondary {
    border: 1px solid var(--neon-cyan);
    color: var(--text-primary);
}

.glow-button.secondary .btn-glow {
    background: radial-gradient(circle, var(--neon-cyan) 0%, transparent 70%);
}

.glow-button.secondary:hover {
    background: var(--neon-cyan);
    color: #000;
    box-shadow: var(--glow-cyan);
}

.glow-button.tiny {
    padding: 8px 16px;
    font-size: 12px;
}

.btn-text {
    position: relative;
    z-index: 2;
}

.btn-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150px;
    height: 150px;
    transform: translate(-50%, -50%) scale(0);
    opacity: 0.15;
    transition: transform 0.5s ease;
    border-radius: 50%;
    z-index: 1;
}

.glow-button:hover .btn-glow {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.3;
}

/* --- Status Boxes (API Check) --- */
.status-box {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px;
    border-radius: 8px;
    font-size: 13px;
    margin-bottom: 20px;
    animation: slideInDown 0.3s ease forwards;
}

.status-box i {
    font-size: 16px;
    margin-top: 2px;
}

.status-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.status-box.success {
    background: rgba(57, 255, 20, 0.06);
    border: 1px solid rgba(57, 255, 20, 0.2);
    color: var(--neon-green);
    box-shadow: inset 0 0 5px rgba(57, 255, 20, 0.05);
}

.status-box.error {
    background: rgba(255, 49, 49, 0.06);
    border: 1px solid rgba(255, 49, 49, 0.2);
    color: var(--neon-red);
    box-shadow: inset 0 0 5px rgba(255, 49, 49, 0.05);
}


/* ==================== SCREEN 1: SPLASH SCREEN ==================== */
#screen-splash {
    background: #050409;
}

.splash-content {
    width: 80%;
    max-width: 900px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
}

.splash-left {
    display: flex;
    flex-direction: column;
}

.splash-title {
    font-family: var(--font-cyber);
    font-size: 48px;
    font-weight: 900;
    letter-spacing: 6px;
    margin-bottom: 4px;
}

.splash-subtitle {
    font-family: var(--font-tech);
    font-size: 16px;
    letter-spacing: 3px;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 30px;
}

.splash-version-details {
    display: flex;
    gap: 24px;
    margin-bottom: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 16px;
}

.detail-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.detail-item span {
    font-size: 11px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.detail-item strong {
    font-size: 13px;
    color: var(--text-primary);
    font-weight: 500;
}

.loader-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.loader-track {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 2px;
    overflow: hidden;
}

.loader-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, var(--neon-purple), var(--neon-cyan));
    border-radius: 2px;
    box-shadow: var(--glow-cyan);
    transition: width 0.1s linear;
}

.loader-text {
    font-family: var(--font-tech);
    font-size: 12px;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    text-transform: uppercase;
}

.splash-right {
    display: flex;
    justify-content: center;
    align-items: center;
}

.logo-outer-glow {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: transparent;
    border: 1px dashed var(--border-glass-cyan);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    animation: rotateDashed 20s linear infinite;
}

.logo-inner-orb {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(189, 93, 255, 0.15) 0%, rgba(0, 243, 255, 0.05) 70%, transparent 100%);
    border: 1px solid var(--border-glass-purple);
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: inset 0 0 20px rgba(189, 93, 255, 0.2);
    animation: pulseOrb 4s ease-in-out infinite alternate;
}

.logo-brain-icon {
    font-size: 45px;
    animation: floatBrain 6s ease-in-out infinite alternate;
}


/* ==================== SCREEN 2 & 3: SETUP CARDS ==================== */
.api-card, .user-card {
    width: 480px;
}

.card-header {
    text-align: center;
    margin-bottom: 24px;
}

.header-icon {
    font-size: 32px;
    margin-bottom: 12px;
}

.card-header h2 {
    font-family: var(--font-cyber);
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--text-primary);
    margin-bottom: 8px;
}

.card-header p {
