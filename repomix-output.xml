class LocalSecurityAdapter(SecurityPort):
    def __init__(
        self,
        *,
        enabled: bool = True,
        sandbox_enabled: bool = True,
        audit_enabled: bool = True,
        default_policy: str = "allow",
        max_risk: str = "critical",
        allowed_paths: tuple[str, ...] = (),
