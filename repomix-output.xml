                category=CapabilityCategory.RUNTIME,
                status=CapabilityStatus.AVAILABLE,
                details={"active_executable": "/usr/bin/python3"},
                last_updated=now,
            )
        )
        mgr.registry._cache.set(
            CapabilityInfo(
                name="adb",
                category=CapabilityCategory.SOFTWARE,
                status=CapabilityStatus.AVAILABLE,
                details={"executable": "/usr/bin/adb"},
                last_updated=now,
            )
        )
        mgr.registry._cache.set(
            CapabilityInfo(
