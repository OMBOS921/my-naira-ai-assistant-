        assert bus is not None

    @pytest.mark.asyncio
    async def test_emit_no_subscribers(self) -> None:
        bus = EventBus()
        await bus.emit("test.event", {"key": "value"})

    @pytest.mark.asyncio
    async def test_shutdown_drains(self) -> None:
        bus = EventBus()
        await bus.shutdown()

    @pytest.mark.asyncio
    async def test_double_shutdown_is_safe(self) -> None:
        bus = EventBus()
        await bus.shutdown()
        await bus.shutdown()

