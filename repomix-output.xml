                        category="browser",
                        timeout_seconds=self._default_timeout,
                    ),
                    self._handle_search_tool,
                )

                register(
                    ToolDefinition(
                        name="browser_click",
                        description="Click an element matching the CSS selector on the active browser page",
                        parameters={
                            "type": "object",
                            "properties": {
