        def _list_procs() -> list[ProcessInfo]:
            attrs = ["pid", "name", "status", "cpu_percent", "memory_info"]
            processes: list[ProcessInfo] = []
            for proc in _psutil_mod.process_iter(attrs):  # type: ignore[union-attr]
                try:
