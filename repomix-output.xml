from __future__ import annotations

import asyncio
import logging
import time
from typing import Any

from backend.modules.voice._exceptions import (
    VoiceTranscriptionError,
    VoiceTimeoutError,
)
from backend.modules.voice._types import AudioData, TranscriptionResult
