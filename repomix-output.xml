        _LOG.info("[BOOT] ContextIntelligence initialised")

        # 7n – RuntimeManager (Layer 4 — Orchestration)
        _LOG.info("[BOOT]   Initialising RuntimeManager ...")
        runtime_mgr = RuntimeManager(
            config=config,
            settings_manager=settings_mgr,
