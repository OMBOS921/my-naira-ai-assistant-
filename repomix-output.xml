/* ============================================================
   NAIRA OS v2 — "Aurora Glass" Design System
   ============================================================ */

:root {
  --bg-0: #070b1e;
  --bg-1: #0b1028;
  --bg-2: #111735;

  --surface: rgba(255, 255, 255, 0.045);
  --surface-2: rgba(255, 255, 255, 0.075);
  --surface-3: rgba(255, 255, 255, 0.11);
  --stroke: rgba(255, 255, 255, 0.09);
  --stroke-2: rgba(255, 255, 255, 0.16);

  --cyan: #22d3ee;
  --blue: #60a5fa;
  --violet: #a78bfa;
  --pink: #f472b6;
  --mint: #34d399;
  --amber: #fbbf24;
  --rose: #fb7185;

  --accent-1: #22d3ee;
  --accent-2: #a78bfa;
  --accent-3: #f472b6;
  --accent-glow: rgba(34, 211, 238, 0.45);

  --text-1: #eef2ff;
  --text-2: #a5b4cf;
  --text-3: #64748b;

  --font-body: 'Inter', 'Nunito', system-ui, sans-serif;
  --font-display: 'Space Grotesk', 'Inter', sans-serif;
  --font-hindi: 'Nunito', 'Inter', sans-serif;

  --radius-lg: 22px;
  --radius-md: 16px;
  --radius-sm: 12px;
  --radius-xs: 9px;

  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
  width: 100%;
  overflow: hidden;
}

body {
  font-family: var(--font-body);
  background: radial-gradient(1200px 800px at 70% -10%, var(--bg-2) 0%, transparent 55%),
    radial-gradient(900px 700px at -10% 110%, #141b3d 0%, transparent 50%),
    var(--bg-0);
  color: var(--text-1);
  -webkit-font-smoothing: antialiased;
  user-select: none;
}

input,
textarea,
select,
button {
  font-family: inherit;
  color: inherit;
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 99px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.22);
}

/* ---------- Typography helpers ---------- */
.font-display {
  font-family: var(--font-display);
  letter-spacing: 0.02em;
}
.text-hindi {
  font-family: var(--font-hindi);
}
.grad-text {
  background: linear-gradient(120deg, var(--accent-1), var(--accent-2) 55%, var(--accent-3));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
.muted {
  color: var(--text-2);
}
.tiny {
  color: var(--text-3);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* ---------- Glass ---------- */
.glass {
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.02));
  border: 1px solid var(--stroke);
  border-radius: var(--radius-lg);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow: 0 18px 60px rgba(2, 6, 23, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.07);
}
.glass-soft {
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid var(--stroke);
  border-radius: var(--radius-md);
}
.glass-hover {
  transition: all 0.35s var(--ease-out);
}
.glass-hover:hover {
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.04));
  border-color: var(--stroke-2);
  transform: translateY(-2px);
}

/* ---------- Buttons ---------- */
.btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 22px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--stroke-2);
  background: var(--surface-2);
  color: var(--text-1);
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.28s var(--ease-out);
  overflow: hidden;
}
.btn:hover {
  transform: translateY(-1px);
  border-color: var(--accent-glow);
  background: var(--surface-3);
}
.btn:active {
  transform: translateY(0) scale(0.98);
}
.btn:disabled {
  opacity: 0.5;
  pointer-events: none;
}
.btn-primary {
  background: linear-gradient(120deg, var(--accent-1), var(--accent-2));
  border: none;
  color: #071021;
  box-shadow: 0 8px 30px var(--accent-glow);
}
.btn-primary:hover {
  filter: brightness(1.12);
  box-shadow: 0 10px 40px var(--accent-glow);
}
.btn-danger {
  background: linear-gradient(120deg, #fb7185, #f43f5e);
  border: none;
  color: #fff;
  box-shadow: 0 8px 30px rgba(244, 63, 94, 0.35);
}
.btn-ghost {
  background: transparent;
  border-color: var(--stroke);
  color: var(--text-2);
}
.btn-ghost:hover {
  color: var(--text-1);
  border-color: var(--stroke-2);
  background: var(--surface-2);
}
.btn-sm {
  padding: 8px 14px;
  font-size: 13px;
  border-radius: var(--radius-xs);
}
.btn-icon {
  padding: 10px;
  border-radius: var(--radius-sm);
}
.btn-tiny {
  padding: 5px 10px;
  font-size: 12px;
  border-radius: 8px;
}

/* ---------- Inputs ---------- */
.field {
  width: 100%;
  padding: 13px 16px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--stroke);
  background: rgba(7, 11, 30, 0.55);
  color: var(--text-1);
  font-size: 14px;
  outline: none;
  transition: all 0.25s var(--ease-out);
}
.field::placeholder {
  color: var(--text-3);
}
.field:focus {
  border-color: var(--accent-1);
  box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.12), 0 0 24px rgba(34, 211, 238, 0.15);
  background: rgba(7, 11, 30, 0.8);
}
.field-label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--text-2);
  margin-bottom: 8px;
}
.field-group {
  margin-bottom: 18px;
}
select.field option {
  background: #0b1028;
  color: var(--text-1);
}

/* ---------- Badges / chips ---------- */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 11px;
  border-radius: 99px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}
.badge-cyan {
  background: rgba(34, 211, 238, 0.12);
  color: var(--cyan);
  border: 1px solid rgba(34, 211, 238, 0.3);
}
.badge-violet {
  background: rgba(167, 139, 250, 0.12);
  color: var(--violet);
  border: 1px solid rgba(167, 139, 250, 0.3);
}
.badge-pink {
  background: rgba(244, 114, 182, 0.12);
  color: var(--pink);
  border: 1px solid rgba(244, 114, 182, 0.3);
}
.badge-mint {
  background: rgba(52, 211, 153, 0.12);
  color: var(--mint);
  border: 1px solid rgba(52, 211, 153, 0.3);
}
.badge-amber {
  background: rgba(251, 191, 36, 0.12);
  color: var(--amber);
  border: 1px solid rgba(251, 191, 36, 0.3);
}
.badge-rose {
  background: rgba(251, 113, 133, 0.12);
  color: var(--rose);
  border: 1px solid rgba(251, 113, 133, 0.3);
}
.badge-gray {
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-2);
  border: 1px solid var(--stroke);
}
.dot {
  width: 7px;
  height: 7px;
  border-radius: 99px;
  background: currentColor;
  box-shadow: 0 0 8px currentColor;
}

/* ---------- Toggle ---------- */
.toggle {
  position: relative;
  width: 44px;
  height: 25px;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.09);
  border: 1px solid var(--stroke);
  cursor: pointer;
  transition: all 0.3s var(--ease-out);
  flex-shrink: 0;
}
.toggle::after {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  width: 19px;
  height: 19px;
  border-radius: 99px;
  background: #cbd5e1;
  transition: all 0.3s var(--ease-out);
}
.toggle.on {
  background: linear-gradient(120deg, var(--accent-1), var(--accent-2));
  border-color: transparent;
  box-shadow: 0 0 18px var(--accent-glow);
}
.toggle.on::after {
  left: 21px;
  background: #fff;
}

/* ---------- Slider ---------- */
input[type='range'] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 6px;
  border-radius: 99px;
  background: linear-gradient(
    to right,
    var(--accent-1) 0%,
    var(--accent-2) var(--fill, 50%),
    rgba(255, 255, 255, 0.1) var(--fill, 50%)
  );
  outline: none;
  cursor: pointer;
}
input[type='range']::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 20px;
  height: 20px;
  border-radius: 99px;
  background: #fff;
  border: 3px solid var(--accent-2);
  box-shadow: 0 0 16px var(--accent-glow);
  cursor: grab;
}

/* ---------- Avatar & halo ---------- */
.avatar-stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.avatar-orb-wrap {
  position: relative;
  display: grid;
  place-items: center;
  animation: orbBounce 3.4s ease-in-out infinite;
}
@keyframes orbBounce {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-7px) scale(1.012);
  }
}
.avatar-halo {
  position: absolute;
  inset: -9%;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    var(--halo-1, var(--violet)),
    var(--halo-2, var(--cyan)) 25%,
    var(--halo-3, var(--pink)) 50%,
    var(--halo-1, var(--violet)) 75%,
    var(--halo-2, var(--cyan))
  );
  filter: blur(9px);
  opacity: 0.85;
  animation: haloSpin 9s linear infinite;
  -webkit-mask: radial-gradient(closest-side, transparent 58%, black 62%, transparent 72%);
  mask: radial-gradient(closest-side, transparent 58%, black 62%, transparent 72%);
}
@keyframes haloSpin {
  to {
    transform: rotate(360deg);
  }
}
.avatar-glow {
  position: absolute;
  inset: -4%;
  border-radius: 50%;
  background: var(--halo-1, var(--violet));
  filter: blur(55px);
  opacity: 0.28;
  animation: glowPulse 3.4s ease-in-out infinite;
}
@keyframes glowPulse {
  0%, 100% {
    opacity: 0.22;
    transform: scale(0.96);
  }
  50% {
    opacity: 0.42;
    transform: scale(1.05);
  }
}
.avatar-video {
  position: relative;
  z-index: 2;
  border-radius: 50%;
  object-fit: cover;
  background: radial-gradient(circle at 50% 30%, #16204a, #0a0f2a 70%);
}
.avatar-video.sm {
  width: 130px;
  height: 130px;
}
.avatar-video.md {
  width: 200px;
  height: 200px;
}
.avatar-video.lg {
  width: 420px;
  height: 420px;
}

/* ---------- Mic button ---------- */
.mic-btn {
  position: relative;
  width: 62px;
  height: 62px;
  border-radius: 50%;
  border: 1px solid var(--stroke-2);
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03));
  color: var(--text-1);
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: all 0.3s var(--ease-out);
}
.mic-btn svg {
  width: 22px;
  height: 22px;
}
.mic-btn:hover {
  transform: scale(1.06);
  border-color: var(--accent-glow);
}
.mic-btn.on {
  background: linear-gradient(120deg, var(--accent-1), var(--accent-2));
  color: #071021;
  box-shadow: 0 0 40px var(--accent-glow);
}
.mic-pulse {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2px solid var(--accent-1);
  animation: micPulse 1.6s ease-out infinite;
  opacity: 0;
}
.mic-btn.on .mic-pulse {
  opacity: 1;
}
@keyframes micPulse {
  0% {
    transform: scale(1);
    opacity: 0.7;
  }
  100% {
    transform: scale(1.75);
    opacity: 0;
  }
}
.mic-label {
  margin-top: 12px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--text-3);
  transition: color 0.3s;
}
.mic-label.on {
  color: var(--accent-1);
  text-shadow: 0 0 14px var(--accent-glow);
}

/* ---------- Sidebar ---------- */
.sidebar {
  width: 74px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 18px 0 14px;
  border-right: 1px solid var(--stroke);
  background: linear-gradient(180deg, rgba(11, 16, 40, 0.55), rgba(7, 11, 30, 0.35));
  backdrop-filter: blur(14px);
  z-index: 30;
}
.sidebar-btn {
  position: relative;
  width: 50px;
  height: 50px;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-3);
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: all 0.3s var(--ease-out);
}
.sidebar-btn svg {
  width: 20px;
  height: 20px;
}
.sidebar-btn:hover {
  color: var(--text-1);
  background: var(--surface-2);
}
.sidebar-btn.active {
  color: #071021;
  background: linear-gradient(120deg, var(--accent-1), var(--accent-2));
  box-shadow: 0 8px 26px var(--accent-glow);
}
.sidebar-btn.active::before {
  content: '';
  position: absolute;
  left: -14px;
  top: 50%;
  transform: translateY(-50%);
  width: 4px;
  height: 22px;
  border-radius: 99px;
  background: var(--accent-1);
  box-shadow: 0 0 12px var(--accent-glow);
}
.sidebar-tooltip {
  position: absolute;
  left: 62px;
  top: 50%;
  transform: translateY(-50%) translateX(-6px);
  background: #0d1330;
  border: 1px solid var(--stroke-2);
  padding: 6px 12px;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-1);
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: all 0.25s var(--ease-out);
  z-index: 60;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}
.sidebar-btn:hover .sidebar-tooltip {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}
.sidebar-spacer {
  flex: 1;
}

/* ---------- Panels / sections ---------- */
.section-panel {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(460px, 92vw);
  z-index: 40;
  display: flex;
  flex-direction: column;
  background: linear-gradient(200deg, rgba(13, 18, 48, 0.82), rgba(7, 11, 30, 0.9));
  border-left: 1px solid var(--stroke);
  backdrop-filter: blur(22px);
  box-shadow: -30px 0 80px rgba(0, 0, 0, 0.5);
}
.section-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 18px 20px;
  border-bottom: 1px solid var(--stroke);
}
.section-head-icon {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-sm);
  display: grid;
  place-items: center;
  background: linear-gradient(120deg, var(--accent-1), var(--accent-2));
  color: #071021;
  box-shadow: 0 6px 20px var(--accent-glow);
}
.section-head-icon svg {
  width: 18px;
  height: 18px;
}
.section-title {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
}
.section-body {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ---------- Cards ---------- */
.card {
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  border: 1px solid var(--stroke);
  border-radius: var(--radius-md);
  padding: 16px;
  transition: all 0.3s var(--ease-out);
}
.card:hover {
  border-color: var(--stroke-2);
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.085), rgba(255, 255, 255, 0.03));
}
.card-title {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-2);
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

/* ---------- Chat bubbles ---------- */
.chat-msg {
  display: flex;
  flex-direction: column;
  max-width: 86%;
  animation: msgIn 0.4s var(--ease-out);
}
@keyframes msgIn {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
.chat-msg.user {
  align-self: flex-end;
  align-items: flex-end;
}
.chat-msg.naira {
  align-self: flex-start;
  align-items: flex-start;
}
.chat-bubble {
  padding: 11px 15px;
  border-radius: 18px;
  font-size: 14px;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}
.chat-msg.user .chat-bubble {
  background: linear-gradient(120deg, var(--accent-1), var(--accent-2));
  color: #071021;
  border-bottom-right-radius: 6px;
  font-weight: 500;
}
.chat-msg.naira .chat-bubble {
  background: var(--surface-2);
  border: 1px solid var(--stroke);
  border-bottom-left-radius: 6px;
}
.chat-meta {
  font-size: 10px;
  color: var(--text-3);
  margin-top: 4px;
  padding: 0 6px;
}

/* ---------- Misc ---------- */
.divider {
  height: 1px;
  background: var(--stroke);
  margin: 6px 0;
}
.row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.grow {
  flex: 1;
}
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.no-scrollbar::-webkit-scrollbar {
  display: none;
}

/* ---------- Toast ---------- */
.toast-wrap {
  position: fixed;
  top: 22px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 200;
  display: flex;
  flex-direction: column;
  gap: 10px;
  align-items: center;
  pointer-events: none;
}
.toast {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 20px;
  border-radius: var(--radius-sm);
  background: linear-gradient(160deg, rgba(20, 26, 58, 0.95), rgba(10, 14, 38, 0.95));
  border: 1px solid var(--stroke-2);
  font-size: 13.5px;
  font-weight: 600;
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6);
  pointer-events: auto;
}
.toast.success {
  border-color: rgba(52, 211, 153, 0.4);
  color: var(--mint);
}
.toast.error {
  border-color: rgba(251, 113, 133, 0.4);
  color: var(--rose);
}
.toast.info {
  border-color: rgba(34, 211, 238, 0.4);
  color: var(--cyan);
}

/* ---------- Modal ---------- */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(4, 7, 20, 0.7);
  backdrop-filter: blur(8px);
  z-index: 150;
  display: grid;
  place-items: center;
  padding: 24px;
}
.modal-card {
  width: min(420px, 94vw);
  padding: 26px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ---------- Progress ---------- */
.progress-track {
  width: 100%;
  height: 6px;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.07);
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 99px;
  background: linear-gradient(90deg, var(--accent-1), var(--accent-2), var(--accent-3));
  box-shadow: 0 0 16px var(--accent-glow);
  transition: width 0.25s var(--ease-out);
}

/* ---------- Boot screen ---------- */
.boot-line {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-display);
  font-size: 12.5px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-3);
  transition: all 0.3s;
}
.boot-line.done {
  color: var(--mint);
}

/* ---------- Status orbit ---------- */
.orbit-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--text-3);
  box-shadow: 0 0 10px currentColor;
  transition: all 0.3s;
}
.orbit-dot.on {
  background: var(--mint);
  box-shadow: 0 0 14px var(--mint);
  animation: glowPulse 2s infinite;
}
.orbit-dot.off {
  background: var(--rose);
  box-shadow: 0 0 14px var(--rose);
}

/* ---------- Animations ---------- */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
.fade-up {
  animation: fadeUp 0.55s var(--ease-out) both;
}
@keyframes shimmer {
  0% {
    background-position: -400px 0;
  }
  100% {
    background-position: 400px 0;
  }
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.spin {
  animation: spin 0.9s linear infinite;
}
.shimmer {
  background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0.05) 75%);
  background-size: 800px 100%;
  animation: shimmer 2.2s infinite linear;
}

@media (max-width: 720px) {
  .section-panel {
    width: 94vw;
  }
  .avatar-video.lg {
    width: 230px;
    height: 230px;
  }
}
