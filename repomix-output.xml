    await asyncio.sleep(0.2)
    res_graph = task_engine.get_graph(graph.task_id)
    assert res_graph is not None
    assert res_graph.state == TaskState.CANCELLED
    assert res_graph.nodes["slow_node"].state == TaskState.CANCELLED


