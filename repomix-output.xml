          className="glass"
          style={{ width: '100%', padding: '30px 34px', display: 'flex', flexDirection: 'column', gap: 22 }}
          initial={{ opacity: 0, y: 30 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.7, ease: [0.22, 1, 0.36, 1] }}
        >
