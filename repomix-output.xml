        cwd: str | None = None,
    ) -> dict[str, Any]:
        """Get repository status.

        Parameters
        ----------
        cwd : str | None
            Repository directory.

        Returns
        -------
        dict[str, Any]
            Status with:
            - modified: list[str]
            - staged: list[str]
            - untracked: list[str]
        """

    @abstractmethod
    async def close(self) -> None:
        """Release Git executor resources."""
