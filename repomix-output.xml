        assert any("Circular" in e for e in errors)

    def test_validate_self_cycle(self) -> None:
        g = DependencyGraph()
        g.add_node("a", ("a",))
        errors = g.validate()
        assert len(errors) >= 1
        assert any("Circular" in e for e in errors)

    def test_can_enable_no_deps(self) -> None:
