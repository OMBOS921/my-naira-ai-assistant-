        for i in range(5):
            await bus.emit("test.event", {"i": i})

        await asyncio.sleep(0.05)
        assert bus.metrics()["dropped_events"] > 0

    @pytest.mark.asyncio
    async def test_block_policy(self) -> None:
        bus = EventBus(
            max_queue_size=1,
            overflow_policy="block",
        )

        async def slow_handler(event: Event) -> None:
