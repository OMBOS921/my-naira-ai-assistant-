    sample_rate : int
        Sample rate in Hz (0 if unknown).
    channels : int
        Number of audio channels (0 if unknown).
    duration_ms : float
        Duration in milliseconds (0.0 if unknown).
    size_bytes : int
        Uncompressed size in bytes (0 if unknown).
