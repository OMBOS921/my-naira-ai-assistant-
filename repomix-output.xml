    Parameters
    ----------
    query : str
        The original search query.
    results : tuple[BrowserSearchResult, ...]
        Individual result items.
    total_estimate : int
        Estimated total number of results (0 if unknown).
    duration_ms : float
        Wall-clock time for the search.
    """

    query: str
    results: tuple[BrowserSearchResult, ...] = ()
    total_estimate: int = 0
    duration_ms: float = 0.0


